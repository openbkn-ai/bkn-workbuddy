{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbkn.ai/schemas/agent-integration/scene-pack.v1.json",
  "title": "OpenBKN agent-integration scene pack v1",
  "description": "Declarative domain wording and starter-question templates. Must not contain credentials, SQL, URLs, internal ids, scripts, query plans, expected answers or grading rules. Content checks beyond this schema (URL/SQL/credential/identifier patterns, placeholder-to-capability rules) live in packages/core/src/scene-pack.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "contract_version", "title", "required_capabilities", "starter_templates"],
  "properties": {
    "schema_version": { "const": 1 },
    "scene_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "contract_version": { "const": "read-v1" },
    "title": { "$ref": "#/$defs/text" },
    "domain_notes": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/text" } },
    "required_capabilities": { "$ref": "#/$defs/capabilities" },
    "starter_templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "requires"],
        "properties": {
          "text": { "$ref": "#/$defs/text" },
          "requires": { "$ref": "#/$defs/capabilities" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "capability": { "enum": ["schema_search", "object_query", "relation_query", "metric_query", "logic_property"] },
    "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } }
  }
}
