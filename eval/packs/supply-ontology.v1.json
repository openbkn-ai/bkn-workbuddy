      "expectTools": ["query_object_instance", "query_metric"],
      "forbidden": ["编造的数量或状态（与上述基准不符）", "声称存在其他状态的订单"],
      "assertions": [
        { "type": "tool_called", "any_of": ["query_object_instance", "query_metric"] },
        { "type": "answer_matches", "pattern": "(?<!\\d)40(?!\\d)" },
        { "type": "answer_contains", "all_of": ["已确认"] },
        { "type": "interaction_count", "equals": 1 },
        { "type": "outcome", "equals": "completed" }
      ],
      "baseline": { "verified": true, "method": "M5 / 2026-09-20 MySQL check; re-checked by R0a query_object_instance and query_metric", "verified_at": "2026-09-28" },
      "followups": [
